# Gentrobyte Environment Configuration Template
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nodemailer SMTP Configuration (Gmail)
EMAIL=your-email@gmail.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
DEV_OTP_FALLBACK=false

# Optional MongoDB Database (for cloud deployment e.g. Vercel)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gentrobyte?retryWrites=true&w=majority

